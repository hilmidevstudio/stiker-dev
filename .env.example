# StickerDrop Environment Configuration Template
# Copy this file to .env for local development.
# NEVER commit .env to version control.

# Safe default: extraction is disabled until an approved adapter is configured.
# Paid providers require explicit opt-in; API keys alone never activate them.
APP_ENV=production
EXTRACTION_PROVIDER=disabled

# Bounded comment discovery limits (used by any compatible adapter).
STICKERDROP_MAX_COMMENT_PAGES=10
STICKERDROP_MAX_REPLY_PARENTS=10
STICKERDROP_MAX_REPLY_PAGES=5

# Optional legacy provider credentials. Keep unused while EXTRACTION_PROVIDER=disabled.
SCRAPESOCIAL_API_KEY=your_scrapesocial_api_key_here
SCRAPESOCIAL_BASE_URL=https://api.scrapesocial.ai

# Alternative Extraction Provider: ScrapeCreators
SCRAPECREATORS_API_KEY=your_scrapecreators_api_key_here
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# Alternative Extraction Provider: Apify
APIFY_API_TOKEN=your_apify_api_token_here

# Local Storage Configuration
STICKERDROP_DB_PATH=data/stickerdrop.db
STICKERDROP_MEDIA_DIR=data/media

# Target Test Video & Comment (Defaults from Research Context)
TEST_TIKTOK_VIDEO_URL=https://vt.tiktok.com/ZSpG1m4EG/
TEST_TIKTOK_COMMENT_URL=https://vt.tiktok.com/ZS9f3yqSf57UR-naeU1/
TEST_TARGET_VIDEO_ID=7708356144804236564
TEST_TARGET_COMMENT_ID=7708394712596972308

# Backend media gateway: approved CDN WebP fetch, redirect, size and abuse guards
STICKERDROP_MEDIA_MAX_BYTES=2000000
STICKERDROP_MEDIA_MAX_REQUESTS_PER_MINUTE=120
STICKERDROP_MEDIA_MAX_CONCURRENT=6
STICKERDROP_MEDIA_CACHE_TTL_SECONDS=300
STICKERDROP_MEDIA_CACHE_MAX_BYTES=16777216
# Optional additional exact CDN root domains (comma-separated); built-in CDN roots remain enabled.
# General www.tiktok.com is intentionally not an allowed media host.
# STICKERDROP_MEDIA_ALLOWED_HOSTS=cdn.your-authorized-provider.example
