# StickerDrop Environment Configuration Template
# Copy this file to .env and insert your real API credentials.
# NEVER commit .env to version control.

# Provider selection is server-side only (do not send provider in mobile requests).
EXTRACTION_PROVIDER=scrapecreators

# Optional provider credentials
SCRAPESOCIAL_API_KEY=your_scrapesocial_api_key_here
SCRAPESOCIAL_BASE_URL=https://api.scrapesocial.ai

# Alternative Extraction Provider: ScrapeCreators
SCRAPECREATORS_API_KEY=your_scrapecreators_api_key_here
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# Alternative Extraction Provider: Apify
APIFY_API_TOKEN=your_apify_api_token_here

# Local Storage Configuration
STICKERDROP_DB_PATH=data/stickerdrop.db
STICKERDROP_MEDIA_DIR=data/media

# Target Test Video & Comment (Defaults from Research Context)
TEST_TIKTOK_VIDEO_URL=https://vt.tiktok.com/ZSpG1m4EG/
TEST_TIKTOK_COMMENT_URL=https://vt.tiktok.com/ZS9f3yqSf57UR-naeU1/
TEST_TARGET_VIDEO_ID=7708356144804236564
TEST_TARGET_COMMENT_ID=7708394712596972308
